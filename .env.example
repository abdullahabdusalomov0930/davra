# Copy to .env.local and fill in. Never commit .env.local.

# Public site URL without a trailing slash. Used for canonical URLs, sitemap and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL and publishable key.
# Local: run `pnpm db:start`, then copy them from `pnpm db:status`.
# Cloud: Supabase Dashboard -> Project Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: public contact address shown on the legal pages (questions, data requests).
NEXT_PUBLIC_CONTACT_EMAIL=

# Supabase secret key (bypasses Row Level Security). Server-only: never expose it to the browser.
SUPABASE_SECRET_KEY=

# Token Vercel Cron sends to /api/cron/* (the weekly link check). At least 16 random characters,
# e.g. `openssl rand -hex 32`. Server-only. Without it the cron routes refuse every call.
CRON_SECRET=
